{
  "name": "mainline",
  "$schema": "https://raw.githubusercontent.com/nrwl/nx/master/packages/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "Mainline",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "DASH0_AUTH_TOKEN=\"${DASH0_AUTH_TOKEN:-}\" OTEL_EXPORTER_OTLP_ENDPOINT=\"${OTEL_EXPORTER_OTLP_ENDPOINT:-}\" xcodebuild -scheme Mainline -configuration Debug -derivedDataPath build build 2>&1 | grep -E '(error:|warning:.*error|BUILD)' || true",
        "cwd": "{projectRoot}"
      },
      "inputs": ["swift-sources", "project-config"],
      "outputs": [],
      "cache": true
    },
    "build:release": {
      "executor": "nx:run-commands",
      "options": {
        "command": "DASH0_AUTH_TOKEN=\"${DASH0_AUTH_TOKEN:-}\" OTEL_EXPORTER_OTLP_ENDPOINT=\"${OTEL_EXPORTER_OTLP_ENDPOINT:-}\" xcodebuild -scheme Mainline -configuration Release -derivedDataPath build clean build ONLY_ACTIVE_ARCH=NO 2>&1 | tail -5",
        "cwd": "{projectRoot}"
      },
      "inputs": ["swift-sources", "project-config"],
      "outputs": [],
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'No test target configured in Xcode scheme. Skipping tests.'",
        "cwd": "{projectRoot}"
      },
      "cache": true
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "rm -rf build",
          "rm -rf $HOME/Library/Developer/Xcode/DerivedData/Mainline-* 2>/dev/null || true",
          "xcodebuild -scheme Mainline clean -quiet 2>/dev/null || true"
        ],
        "cwd": "{projectRoot}",
        "parallel": false
      },
      "cache": false
    },
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "pkill -x Mainline 2>/dev/null && sleep 1 || true",
            "description": "Kill running app"
          },
          {
            "command": "rm -rf /Applications/Mainline.app 2>/dev/null || true",
            "description": "Remove old installation"
          },
          {
            "command": "cp -R build/Build/Products/Debug/Mainline.app /Applications/Mainline.app",
            "description": "Install to Applications"
          }
        ],
        "cwd": "{projectRoot}",
        "parallel": false
      },
      "dependsOn": ["build"],
      "cache": false
    },
    "install:launch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "open /Applications/Mainline.app",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["install"],
      "cache": false
    },
    "install:full": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sh ./scripts/install.sh",
        "cwd": "{projectRoot}"
      },
      "inputs": ["swift-sources", "project-config", "scripts"],
      "outputs": [],
      "cache": true
    },
    "install:full:launch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sh ./scripts/install.sh --launch",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["install:full"],
      "cache": false
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sh ./scripts/dev.sh",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "reset": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm dlx nx reset",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "release": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/release.sh",
        "cwd": "{projectRoot}"
      },
      "inputs": ["swift-sources", "project-config", "scripts", "cask"],
      "cache": false
    },
    "setup-tap": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/setup-tap.sh",
        "cwd": "{projectRoot}"
      },
      "inputs": ["cask"],
      "cache": false
    }
  }
}
