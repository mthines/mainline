{
  "$schema": "https://raw.githubusercontent.com/nrwl/nx/master/packages/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*"
    ],
    "swift-sources": [
      "{projectRoot}/Mainline/**/*.swift",
      "{projectRoot}/Mainline/**/*.plist",
      "{projectRoot}/Mainline/**/*.entitlements",
      "{projectRoot}/Mainline/**/*.xcassets",
      "{projectRoot}/Mainline/**/*.xib",
      "{projectRoot}/Mainline/**/*.storyboard"
    ],
    "project-config": [
      "{projectRoot}/Mainline.xcodeproj/**/*",
      "{projectRoot}/*.xcworkspace/**/*"
    ],
    "scripts": [
      "{projectRoot}/scripts/**/*.sh"
    ],
    "cask": [
      "{projectRoot}/Casks/**/*.rb"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "inputs": [
        "swift-sources",
        "project-config"
      ],
      "outputs": [
        "{projectRoot}/build"
      ]
    },
    "test": {
      "cache": true,
      "inputs": [
        "swift-sources",
        "project-config"
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "install": {
      "cache": true,
      "inputs": [
        "swift-sources",
        "project-config"
      ],
      "outputs": [
        "{projectRoot}/build"
      ],
      "dependsOn": [
        "clean"
      ]
    },
    "clean": {
      "cache": false
    }
  },
  "defaultBase": "main",
  "analytics": true
}